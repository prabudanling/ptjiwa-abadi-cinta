// This is your Prisma schema file,
// PT JIWA ABDI CINTA - Super App Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      String   @default("pelanggan") // super_admin, admin_perdagangan, admin_jasa, admin_konstruksi, admin_industri, admin_pertanian, mitra, pelanggan
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  orders         Order[]
  serviceBookings ServiceBooking[]
  tenderBids     TenderBid[]
}

// ============================================
// MODUL PERDAGANGAN (Trading/Marketplace)
// ============================================

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   // ekspor, impor, mesin, bahan_baku_sawit, lainnya
  kbliCode    String?
  price       Float
  unit        String   // ton, kg, unit, dll
  minOrder    Float    @default(1)
  stock       Float    @default(0)
  images      String?  // JSON array of URLs
  isVerified  Boolean  @default(false)
  sellerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id])
  orders OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  buyerId       String
  status        String   @default("pending") // pending, confirmed, negotiated, shipped, delivered, cancelled
  totalAmount   Float
  paymentStatus String   @default("unpaid") // unpaid, partial, paid
  shippingAddr  String?
  trackingCode  String?
  notes         String?
  invoiceUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyer User @relation(fields: [buyerId], references: [id])
  items  OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Float
  subtotal  Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ============================================
// MODUL JASA (Services/Consulting/MICE)
// ============================================

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   // konsultasi_manajemen, teknis, hukum_bisnis, mice, pelatihan
  kbliCode    String?
  price       Float
  duration    String?  // e.g. "2 jam", "1 hari", "3 bulan"
  provider    String?  // consultant/trainer name
  rating      Float    @default(0)
  reviewCount Int     @default(0)
  isOnline    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings ServiceBooking[]
}

model ServiceBooking {
  id          String   @id @default(cuid())
  bookingCode String   @unique
  serviceId   String
  userId      String
  status      String   @default("pending") // pending, confirmed, completed, cancelled
  scheduleDate DateTime
  notes       String?
  rating      Float?
  review      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model MICEEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  eventType   String   // conference, exhibition, seminar, workshop, incentive_trip
  startDate   DateTime
  endDate     DateTime
  location    String
  virtualLink String?
  capacity    Int
  registered  Int      @default(0)
  ticketPrice Float    @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODUL KONSTRUKSI (Construction/Tender)
// ============================================

model Project {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String   // gedung, sipil, irigasi, jalan, lainnya
  kbliCode      String?
  location      String
  budgetEstimate Float
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("announced") // announced, bidding, in_progress, completed, cancelled
  progress      Float    @default(0) // 0-100%
  contractNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenders Tender[]
  reports DailyReport[]
}

model Tender {
  id          String   @id @default(cuid())
  projectId   String
  tenderNumber String  @unique
  announcedDate DateTime
  closingDate DateTime
  status      String   @default("open") // open, evaluation, awarded, closed
  requirements String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id])
  bids    TenderBid[]
}

model TenderBid {
  id          String @id @default(cuid())
  tenderId    String
  contractorId String
  bidAmount   Float
  proposal    String?
  sbuNumber   String? // Sertifikat Badan Usaha
  isWinner    Boolean @default(false)
  createdAt   DateTime @default(now())

  tender     Tender @relation(fields: [tenderId], references: [id])
  contractor User   @relation(fields: [contractorId], references: [id])
}

model DailyReport {
  id        String   @id @default(cuid())
  projectId String
  date      DateTime
  activity  String
  progress  Float    // incremental
  issues    String?
  imageUrl  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// ============================================
// MODUL INDUSTRI (Palm Oil/CPO Trading)
// ============================================

model Commodity {
  id          String   @id @default(cuid())
  name        String   // CPO, Minyak Goreng, Fraksinasi, dll
  category    String   // cpo, minyak_goreng, fraksinasi, olein, stearin, inti_sawit
  kbliCode    String?
  currentPrice Float
  priceUnit   String   @default("Rp/ton")
  priceChange Float    @default(0) // percentage change
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceHistory CommodityPrice[]
  trades       CommodityTrade[]
}

model CommodityPrice {
  id          String   @id @default(cuid())
  commodityId String
  price       Float
  date        DateTime
  source      String?
  createdAt   DateTime @default(now())

  commodity Commodity @relation(fields: [commodityId], references: [id])
}

model CommodityTrade {
  id          String   @id @default(cuid())
  commodityId String
  type        String   // buy, sell
  quantity    Float    // in tons
  price       Float    // price per unit
  totalAmount Float
  counterparty String
  status      String   @default("pending") // pending, confirmed, shipped, delivered
  deliveryDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commodity Commodity @relation(fields: [commodityId], references: [id])
}

model Factory {
  id          String   @id @default(cuid())
  name        String
  location    String
  type        String   // pabrik_fraksinasi, pabrik_minyak_goreng, pabrik_pemurnian
  capacity    Float    // tons/day
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  location    String
  capacity    Float    // tons
  currentStock Float  @default(0)
  commodityType String?
  factoryId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODUL PERTANIAN, KEHUTANAN, PERIKANAN
// ============================================

model Plantation {
  id          String   @id @default(cuid())
  name        String
  location    String
  area        Float    // hectares
  cropType    String   // kelapa_sawit, karet, kayu, dll
  plantingYear Int?
  productivity Float?  // ton/ha/year
  certification String? // RSPO, ISPO, dll
  mapCoords   String?  // GeoJSON
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  harvestRecords HarvestRecord[]
}

model HarvestRecord {
  id            String   @id @default(cuid())
  plantationId  String
  date          DateTime
  quantity      Float    // tons
  quality       String?  // grade A, B, C
  notes         String?
  createdAt     DateTime @default(now())

  plantation Plantation @relation(fields: [plantationId], references: [id])
}

model Fishery {
  id          String   @id @default(cuid())
  name        String
  location    String
  type        String   // tambak, keramba_jaring_apung, perairan_umum
  species     String
  capacity    Float
  production  Float?   // tons/year
  certification String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Forestry {
  id          String   @id @default(cuid())
  name        String
  location    String
  area        Float    // hectares
  forestType  String   // hutan_tanaman_industri, hutan_alam, hutan_lindung
  species     String
  certification String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODUL PERIZINAN & SERTIFIKASI — DIHAPUS
// (Modul ini telah dihapus dari sistem sesuai kebijakan perusahaan)
// ============================================

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}
